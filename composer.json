{
    "name": "cdpi/website-v2-plugins",
    "description": "Pinned WordPress plugin set baked into the cdpi/website-v2 container image (ADR-004).",
    "type": "project",
    "license": "proprietary",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        }
    ],
    "require": {
        "composer/installers": "^2",
        "wpackagist-plugin/advanced-custom-fields": "6.8.1",
        "wpackagist-plugin/custom-post-type-ui": "1.19.2",
        "wpackagist-plugin/duracelltomi-google-tag-manager": "2.0.3",
        "wpackagist-plugin/mailchimp-for-wp": "4.12.5",
        "wpackagist-plugin/redirection": "5.7.5",
        "wpackagist-plugin/wordpress-importer": "0.9.5"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
