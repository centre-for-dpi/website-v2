{
  "name": "@cdpi/wp-theme",
  "private": true,
  "version": "1.0.0",
  "description": "WordPress theme for the CDPI Website",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "webpack --node-env=production",
    "dev": "webpack watch --node-env=development",
    "lint": "prettier --check styles/",
    "format": "prettier --write styles/"
  },
  "lint-staged": {
    "styles/**/*.{js,jsx,ts,tsx,json,scss}": "prettier --write"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "browser-sync-webpack-plugin": "^2.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "prettier": "3.0.0",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-manifest-plugin": "^6.0.1",
    "webpackbar": "^7.0.0"
  },
  "dependencies": {
    "web-vitals": "^4.2.4"
  }
}
