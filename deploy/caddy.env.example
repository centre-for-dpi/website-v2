# /etc/cdpi/caddy.env — reverse-proxy configuration.
# Install as root:root 0600 at /etc/cdpi/caddy.env. No secrets live here,
# but it sits with the others so the whole directory is root-only.

# The site address Caddy serves and requests a certificate for.
# production:            cdpi.dev
# staging, subdomain:    staging.cdpi.dev
# staging, IP-only mode: the Elastic IP, e.g. 13.200.1.1
SITE_HOST=staging.example.org

# "internal" -> Caddy's local CA. Required in staging IP-only mode, because
#               no public CA issues certificates for bare IP addresses.
#               After the first `up`, export the root so admins and the
#               pipeline can trust it:
#                 docker compose exec caddy \
#                   cat /data/caddy/pki/authorities/local/root.crt \
#                   > /opt/cdpi/caddy-root.crt
# ""        -> automatic public certificates (Let's Encrypt / ZeroSSL).
#              Always production; also staging in subdomain mode.
# Any other value is a hard startup error, by design.
CADDY_TLS=internal

# staging | production. "staging" adds `X-Robots-Tag: noindex, nofollow`
# to every response. Belt to the theme's own noindex braces.
CADDY_ENV=staging
