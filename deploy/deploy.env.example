# /etc/cdpi/deploy.env — how cdpi-deploy-root behaves on this host.
# Install as root:root 0600 at /etc/cdpi/deploy.env.
# Sourced by cdpi-deploy-root (`set -a; . deploy.env`), so it is bash
# assignment syntax: one KEY=value per line, and any value containing spaces
# MUST be quoted. No command substitution, no pipes, nothing executable.
# Unlike app.env / caddy.env / db.env, this file is never read by docker compose.

# staging | production. Informational: it appears in the log lines and the
# break-glass notifications so you can tell the hosts apart at a glance.
ENV=staging

# Must equal SITE_HOST in caddy.env. The smoke check fetches
# https://$SITE_HOST/ with --resolve to 127.0.0.1, so a CDN in front of the
# site can never answer the check with a cached page.
SITE_HOST=staging.example.org

# Where the compose files and Caddyfile live on the host.
COMPOSE_DIR=/opt/cdpi

# Space-separated and quoted, in order. Each name is resolved inside COMPOSE_DIR.
#   staging:    "compose.yaml compose.staging.yaml"
#   production: "compose.yaml compose.production.yaml"
COMPOSE_FILES="compose.yaml compose.staging.yaml"

# Pre-deploy database dumps and hard-linked uploads snapshots land here.
BACKUP_DIR=/var/backups/cdpi

# container -> mysqldump runs inside the `db` service (staging)
# host      -> mysqldump runs on the host via MYSQL_DEFAULTS_FILE (production)
DB_MODE=container

# host mode only: a root-owned 0600 my.cnf holding [client] user/password for
# the backup account. Keeps credentials off the process list.
MYSQL_DEFAULTS_FILE=/etc/cdpi/my.cnf

# How many ghcr.io/centre-for-dpi/website-v2 images to keep locally, on top of
# the images the current and previous tags point at (those are never removed).
KEEP_IMAGES=3

# How many database dumps and uploads snapshots to keep in BACKUP_DIR.
KEEP_BACKUPS=5

# Path to the Caddy internal-CA root when CADDY_TLS=internal, so the host-side
# smoke check can verify the certificate. Leave empty when CADDY_TLS is empty
# (a public certificate verifies against the system trust store).
SMOKE_CA_CERT=/opt/cdpi/caddy-root.crt

# Optional. A shell command that receives the break-glass alert text on stdin,
# run by /usr/local/sbin/cdpi-breakglass-notify. Empty = journal/auth.log only.
# Example (note the quotes):
#   BREAKGLASS_NOTIFY_CMD="curl -sS -X POST --data-binary @- https://hooks.example.org/xxxx"
BREAKGLASS_NOTIFY_CMD=""
