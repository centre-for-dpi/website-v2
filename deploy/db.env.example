# /etc/cdpi/db.env — STAGING ONLY. Not installed on production, where MySQL
# runs on the host and is never managed by compose.
# Install as root:root 0600 at /etc/cdpi/db.env.
#
# Read by the `db` service in deploy/compose.staging.yaml, and by
# cdpi-deploy-root's container-mode mysqldump (which reads MYSQL_ROOT_PASSWORD
# and MYSQL_DATABASE from inside the running container, not from this file).
#
# MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD must match
# WORDPRESS_DB_NAME / WORDPRESS_DB_USER / WORDPRESS_DB_PASSWORD in app.env.
#
# Generate each password with: openssl rand -base64 30 | tr -d '/+='

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=cdpi_wp
MYSQL_USER=cdpi
MYSQL_PASSWORD=change-me
