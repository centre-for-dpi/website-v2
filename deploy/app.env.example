# /etc/cdpi/app.env — WordPress runtime configuration (ADR-005).
#
# Install as: root:root 0600 at /etc/cdpi/app.env on the host.
# This file documents the KEYS ONLY. Never commit real values.
# Read by the `wordpress` service via `env_file` in deploy/compose.yaml.
#
# docker compose does not expand shell syntax in env_file values: write
# literals, unquoted, no inline comments on a value line.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# staging:    db                    (the mysql container in compose.staging.yaml)
# production: host.docker.internal  (MySQL stays on the Lightsail host;
#                                    compose.production.yaml adds host-gateway)
WORDPRESS_DB_HOST=db

WORDPRESS_DB_USER=cdpi
WORDPRESS_DB_PASSWORD=change-me
WORDPRESS_DB_NAME=cdpi_wp

# Must match the live database exactly on production (from wp-config.php on
# the Lightsail box, `table_prefix`). Getting this wrong shows an install screen.
WORDPRESS_TABLE_PREFIX=wp_

# ---------------------------------------------------------------------------
# Salts and keys — all eight are required
# ---------------------------------------------------------------------------
# production: copy the existing values verbatim out of the live
#             /var/www/cdpi-website/wp-config.php. Changing them logs every
#             editor out and invalidates password-reset links.
# staging:    generate a fresh independent set:
#               curl -s https://api.wordpress.org/secret-key/1.1/salt/
#             (that returns PHP define() lines; take the value inside the
#             second quotes of each line)
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# ---------------------------------------------------------------------------
# URLs — read by docker/wp-config.php (WP8/WP3), not by the official entrypoint
# ---------------------------------------------------------------------------
# Both must carry the scheme and no trailing slash, and must match what is in
# the database (wp option get home / siteurl), or WordPress will redirect-loop.
# staging IP-only mode: https://<elastic ip>
WP_HOME=https://staging.example.org
WP_SITEURL=https://staging.example.org

# staging | production. Drives the theme's noindex behaviour and
# wp_get_environment_type(). Anything other than "production" is treated as
# non-production by the theme.
WP_ENVIRONMENT_TYPE=staging

# 0 on both hosts. Turn on only for a short, deliberate debugging window.
WORDPRESS_DEBUG=0
